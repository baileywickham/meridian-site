    </item>
    <item>
      <title>0.6.4</title>
      <pubDate>Thu, 15 Oct 2026 23:37:43 GMT</pubDate>
      <sparkle:version>470</sparkle:version>
      <sparkle:shortVersionString>0.6.4</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>27.0</sparkle:minimumSystemVersion>
      <description>&lt;p&gt;Better Apple Intelligence summaries: dates come from the email itself, no filler bullets or copied examples, and summaries no longer get stuck on Basic at launch. The AI draft reply is gone.&lt;/p&gt;</description>
      <enclosure url="https://github.com/baileywickham/meridian-site/releases/download/v0.6.4/Meridian-0.6.4.dmg" type="application/octet-stream" length="10426452" sparkle:edSignature="QDY++wxd4MnpymnUw7kKP7iX4ADFQR+32bQdkMXdhR4OevWL8OWtkrOxeoBamI98sKG8UBbcWCxAYTQJ+qRhCg==" />
    </item>
    <item>
      <title>0.6.3</title>
      <pubDate>Thu, 15 Oct 2026 05:43:17 GMT</pubDate>
      <sparkle:version>467</sparkle:version>
      <sparkle:shortVersionString>0.6.3</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>27.0</sparkle:minimumSystemVersion>
      <description>&lt;p&gt;Bcc: compose with Bcc, and see who you Bcc'd on your sent mail&lt;/p&gt;</description>
      <enclosure url="https://github.com/baileywickham/meridian-site/releases/download/v0.6.3/Meridian-0.6.3.dmg" type="application/octet-stream" length="10459256" sparkle:edSignature="L+nxf4W5AF/eekW0VMqVa/Fm9h2eahh7zrSny87X3OdZteZONLKungo9JBzVZMZkCh6WcVnUlYpe5uPaJHwZDQ==" />
