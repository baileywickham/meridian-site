    <item>
      <title>0.6.5</title>
      <pubDate>Fri, 16 Oct 2026 00:50:13 GMT</pubDate>
      <sparkle:version>473</sparkle:version>
      <sparkle:shortVersionString>0.6.5</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>27.0</sparkle:minimumSystemVersion>
      <description>&lt;p&gt;Apple Intelligence summaries and triage actually run again (they were stuck on Basic). Basic summaries no longer repeat the email or ask about events that are over.&lt;/p&gt;</description>
