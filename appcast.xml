    <item>
      <title>0.6.2</title>
      <pubDate>Wed, 14 Oct 2026 17:39:11 GMT</pubDate>
      <sparkle:version>464</sparkle:version>
      <sparkle:shortVersionString>0.6.2</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>27.0</sparkle:minimumSystemVersion>
      <description>&lt;p&gt;The send toast now reads "Sent · Undo" (no countdown); the Undo goes when the window ends. Toasts no longer truncate Undo. To/Cc suggestions include your own addresses.&lt;/p&gt;</description>
      <enclosure url="https://github.com/baileywickham/meridian-site/releases/download/v0.6.2/Meridian-0.6.2.dmg" type="application/octet-stream" length="10451974" sparkle:edSignature="wMvlJDqMoD3d2k6xUx4ErrWa9UsKZS3IAt6gmKdU8QuKHHLWvybaMe5QtbkKZwMu+9nAo6VE5vTMVqbpOQGDCQ==" />
    </item>
    <item>
      <title>0.6.1</title>
      <pubDate>Wed, 14 Oct 2026 15:14:04 GMT</pubDate>
      <sparkle:version>461</sparkle:version>
      <sparkle:shortVersionString>0.6.1</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>27.0</sparkle:minimumSystemVersion>
      <description>&lt;p&gt;Browsing mail no longer marks threads read: j/k, arrows, clicks and archive only preview. Return, o or double-click opens a thread and marks it read.&lt;/p&gt;</description>
      <enclosure url="https://github.com/baileywickham/meridian-site/releases/download/v0.6.1/Meridian-0.6.1.dmg" type="application/octet-stream" length="10443969" sparkle:edSignature="goy6yx0t2sjglLGUfvAsOOPoB5mp637qMCO+rrzm1NmY3GDJk24NYsGFRcuVYNqWSgIZjrfmZ4N59zUeSIaiCw==" />
    </item>
    <item>
      <title>0.6.0</title>
      <pubDate>Wed, 14 Oct 2026 06:20:47 GMT</pubDate>
      <sparkle:version>458</sparkle:version>
      <sparkle:shortVersionString>0.6.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>27.0</sparkle:minimumSystemVersion>
      <description>&lt;p&gt;Mail is marked read only when you open a thread (Return, o or double-click); browsing the list just previews. While a thread is open, arrows and space scroll it, n/p step through its messages, and the list highlight turns grey. Fixes: a newer toast no longer takes away a pending send's Undo, and each Undo button undoes its own action.&lt;/p&gt;</description>
      <enclosure url="https://github.com/baileywickham/meridian-site/releases/download/v0.6.0/Meridian-0.6.0.dmg" type="application/octet-stream" length="10490327" sparkle:edSignature="Un6onlIPWJZ574fIKc1o9qM+rcHNqFtCT06nVdk0q5yLo0T6DIIoeG5j+yIH22yE9fA1zU/+UCSgC6Y1TJ59Dg==" />
    </item>
    <item>
      <title>0.5.1</title>
      <pubDate>Tue, 13 Oct 2026 19:47:46 GMT</pubDate>
      <sparkle:version>451</sparkle:version>
      <sparkle:shortVersionString>0.5.1</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>27.0</sparkle:minimumSystemVersion>
      <description>&lt;p&gt;Fixes for mail and calendar edge cases: Reply honours Reply-To and never answers your own drafts; deleting one message no longer makes a whole thread look trashed; a failing calendar keeps its events; moving a repeating series to another day moves every occurrence; guests' notes and plus-ones survive edits; Google Calendar descriptions show as plain text; better handling of attached messages, inline attachments, international charsets and format=flowed mail.&lt;/p&gt;</description>
      <enclosure url="https://github.com/baileywickham/meridian-site/releases/download/v0.5.1/Meridian-0.5.1.dmg" type="application/octet-stream" length="10468280" sparkle:edSignature="x2Fh1I5IYgAQ3Vrf/sDKar3W11p1J1VzG87UIH+YBTLfxDX41+Si4oEJbXbU2NXmB+jlJ/xVFoh4UVMzn1+yDQ==" />
    </item>
    <item>
      <title>0.5.0</title>
      <pubDate>Tue, 13 Oct 2026 17:15:10 GMT</pubDate>
      <sparkle:version>448</sparkle:version>
      <sparkle:shortVersionString>0.5.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>27.0</sparkle:minimumSystemVersion>
      <description>&lt;p&gt;Live calendar updates: your calendar refreshes the moment it changes elsewhere (with instant notifications on). Invitations whose event was deleted now say so and no longer offer Accept / Maybe / Decline, and invite cards re-check with Google when you open the email.&lt;/p&gt;</description>
      <enclosure url="https://github.com/baileywickham/meridian-site/releases/download/v0.5.0/Meridian-0.5.0.dmg" type="application/octet-stream" length="10412412" sparkle:edSignature="hKBAvE0yYpu5HTYz++oMPh1lkdnXot+VvskcAZVB1oJJ6lslR0L3VosiUN64yKYE9UxMh/UwYcCV8YWEEp/3CA==" />
    </item>
    <item>
      <title>0.4.0</title>
      <pubDate>Tue, 13 Oct 2026 04:52:02 GMT</pubDate>
      <sparkle:version>445</sparkle:version>
      <sparkle:shortVersionString>0.4.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>27.0</sparkle:minimumSystemVersion>
      <description>&lt;p&gt;Full Gmail and Calendar access at sign-in (no more Enable editing); clicking away from the event editor discards unsaved changes; security fixes: calendar writes need the calendar grant, sends only from the account shown in From, one allowed-permission set on Mac and iPhone; plus fixes from the second-model review.&lt;/p&gt;</description>
      <enclosure url="https://github.com/baileywickham/meridian-site/releases/download/v0.4.0/Meridian-0.4.0.dmg" type="application/octet-stream" length="10357019" sparkle:edSignature="Yo0udzn3yRgN4RI0ugVJyCxQBoYQFPowh+lQPZOsmJQ8nA8idbig5sEIiIBWgrTJJsMmXaQyQ0SMo6McUTwFDA==" />
    </item>
    <item>
      <title>0.3.0</title>
      <pubDate>Mon, 12 Oct 2026 21:45:53 GMT</pubDate>
      <sparkle:version>377</sparkle:version>
      <sparkle:shortVersionString>0.3.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>27.0</sparkle:minimumSystemVersion>
      <description>&lt;p&gt;Identity from Google only (colleague calendars are read-only, RSVPs only as you); safer sends (no double sends, may-have-sent checked by send id and Gmail history); snooze, invite card and recurring-event fixes; calendar disk cache and refresh; faster launch and triage; a sign-in welcome screen instead of sample data.&lt;/p&gt;</description>
      <enclosure url="https://github.com/baileywickham/meridian-site/releases/download/v0.3.0/Meridian-0.3.0.dmg" type="application/octet-stream" length="10331806" sparkle:edSignature="yfJJMLw2dbFuAyDyJjqmsp2XN8bDKUIWKGsMYXdCtNBYugoRuVkF8vcO7Sr8R7kvGPxK9rdMvccxjJFlwi+LAA==" />
    </item>
